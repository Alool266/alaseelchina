# Web3Forms (https://web3forms.com)
# 1. Sign up and create a form with destination email: info@alaseelchina.com
# 2. Copy the access key
# 3. Paste into js/config.js (WEB3FORMS_ACCESS_KEY) OR js/config.local.js
#
# Note: This is a static GitHub Pages site — there is no server-side .env loader.
# The key is read from js/config.js / js/config.local.js in the browser.
WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
